# ====================================================================
# BloodBridge Environment Configuration Blueprint (.env.example)
# ====================================================================
# Instructions:
# 1. Duplicate this file and rename it to '.env' in the project root.
# 2. Replace placeholder values with your local or production values.
# 3. NEVER commit your actual '.env' file to Git.
# ====================================================================

# Application Mode ('development', 'production', 'testing')
FLASK_ENV=development
FLASK_DEBUG=1

# Secret Key for Session Signing & Token Cryptography
# Generate a secure key in Python using: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-a-random-super-secret-key-32-chars

# --------------------------------------------------------------------
# Database Connection (MySQL / MariaDB)
# Format: mysql+pymysql://<user>:<password>@<host>:<port>/<dbname>
# Special characters in passwords (e.g. '@', ':') must be URL-encoded (e.g. '@' -> '%40')
# --------------------------------------------------------------------
DATABASE_URL=mysql+pymysql://your_db_user:your_db_password@localhost:3306/bloodbridge

# --------------------------------------------------------------------
# Initial System Administrator Setup (Optional)
# (Used when setting up initial admin via: python scripts/init_db.py)
# --------------------------------------------------------------------
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=your_secure_admin_password_here

# --------------------------------------------------------------------
# Server Host & Port Binding
# --------------------------------------------------------------------
PORT=5000
HOST=0.0.0.0

# --------------------------------------------------------------------
# Emergency Hotline Dispatch Number
# --------------------------------------------------------------------
EMERGENCY_HOTLINE=+91 1800-000-000
