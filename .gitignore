# ====================================================================
# BloodBridge Production Git Ignore Rules (.gitignore)
# ====================================================================

# 1. Environment Secrets & API Keys (NEVER COMMIT SENSITIVE DATA)
.env
.env.local
.env.*.local
.env.development.local
.env.test.local
.env.production.local
!.env.example
*.pem
*.key
*.cert
*.pfx

# 2. Byte-compiled / Optimized Python Files
__pycache__/
*.py[cod]
*$py.class
*.pyc
*.pyo
*.pyd

# 3. Virtual Environments
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/

# 4. Distribution, Builds & Packaging
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# 5. Unit Tests, Coverage & Caches
htmlcov/
.tox/
.nox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
*.py,cover
.hypothesis/
.pytest_cache/

# 6. Flask & WebAssets Cache
instance/
.webassets-cache/

# 7. Local Database Binaries & Dumps
*.sqlite
*.sqlite3
*.db
!schema.db
*.sql.gz
*.bak

# 8. Operating System & Editor Metadata
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# 9. Logs
*.log
pip-log.txt
pip-delete-this-directory.txt
